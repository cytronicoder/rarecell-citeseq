# Python artifacts
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Environments
.env
.venv
env/
venv/

# Large binary data formats (anywhere in tree)
*.h5ad
*.h5mu
*.loom
*.mtx
*.zarr/

# Raw and processed data directories
data/*
!data/README.md
!data/.gitkeep

# Stale matplotlib config cache written inside src/ (bug now fixed; exclude as safety net)
src/results/

# Generated results — keep only the empty .gitkeep placeholders
results/figures/*
!results/figures/.gitkeep
results/tables/*
!results/tables/.gitkeep
results/metrics/*
!results/metrics/.gitkeep
results/logs/*
!results/logs/.gitkeep
results/reports/*
!results/reports/.gitkeep
results/intermediate/*
!results/intermediate/.gitkeep
